# Copia este archivo a .env para desarrollo local.
# En produccion usa valores reales y secretos generados fuera del repositorio.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Usa sqlite solo para desarrollo local. En produccion usa postgres.
DJANGO_DATABASE=sqlite
POSTGRES_DB=robot_tournament
POSTGRES_USER=robot_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Configuracion SMTP para comunicaciones reales.
# No subas el .env real. No uses la contrasena normal del correo si el proveedor requiere contrasena de aplicacion.
# Configura SMTP antes de usar prueba controlada o envio real.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=correo_institucional@dominio.edu.co
EMAIL_HOST_PASSWORD=app_password_o_clave_smtp
DEFAULT_FROM_EMAIL=correo_institucional@dominio.edu.co
EMAIL_USE_SSL=False

# Conversor DOCX -> PDF para invitaciones.
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
# Linux: /usr/bin/libreoffice
LIBREOFFICE_BINARY=
