# Copia este archivo a .env para desarrollo local.
# En produccion usa valores reales y secretos generados fuera del repositorio.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Usa sqlite solo para desarrollo local. En produccion usa postgres.
DJANGO_DATABASE=sqlite
POSTGRES_DB=robot_tournament
POSTGRES_USER=robot_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

# Para pruebas reales con correo temporal/personal, confirma explicitamente el envio
# desde el panel o con --yes en comandos:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=correo_de_prueba@gmail.com
# EMAIL_HOST_PASSWORD=app-password-o-contrasena-temporal
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=correo_de_prueba@gmail.com
